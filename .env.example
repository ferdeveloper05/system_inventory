# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=inventory_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/inventory_db

# Security & JWT
SECRET_KEY=super_secret_jwt_key_change_in_production_min_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API Settings
PROJECT_NAME="Sistema de Gestión de Inventarios y Trazabilidad"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1

